# Copy to .env and fill in. Values are read by cmca/env.py and never printed.

# self-hosted Nemotron checkpoints (cmca/shen/serving/nemotron_modal.py): the server's URL and its --api-key
NEMOTRON_BASE_URL=
NEMOTRON_API_KEY=
# judges from their makers' APIs (run with CMCA_HOSTS=native): GPT-4o, gpt-5.5 and gpt-5.4 (OpenAI);
# Claude Opus 5.5 and Claude Opus 4.5 (Anthropic)
OPENAI_API_KEY=
ANTHROPIC_API_KEY=
# Gemini 3.1 Pro on Vertex AI (application-default credentials for this project)
GCLOUD_PROJECT=
# optional: Azure AI Foundry, the OpenAI-compatible host used when CMCA_HOSTS is not native
AZURE_BASE_URL=
AZURE_API_KEY=
